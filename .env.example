# Banco SQLite do catálogo de modelos
DB_FILE=ai_host.db

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Limite de tokens por resposta (vazio = sem limite).
# Use o mesmo valor no baseline e na proposta durante os experimentos.
OLLAMA_NUM_PREDICT=

# Tags de fallback usadas quando a classe não tem modelo ativo no catálogo.
# MODELO_* é o contrato de src/classificador.py.
MODELO_SIMPLES=Alieno/ailo-152m-v2
MODELO_CODIGO=qwen2.5-coder:0.5b
MODELO_COMPLEXO=phi3.5
FALLBACK_MODEL=phi3.5

# API do load balancer
LOADBALANCER_HOST=127.0.0.1
LOADBALANCER_PORT=8000

# URL usada pelos scripts de experimento
LB_URL=http://127.0.0.1:8000

# Logging
DEV_MODE=true
