DB_FILE=local.db

# Ollama local. 127.0.0.1 evita atraso de IPv6 em localhost.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_PREDICT=256

# Tags iguais às de `ollama list` (fallback quando o catálogo não define a classe).
MODELO_SIMPLES=Alieno/ailo-152m-v2
MODELO_CODIGO=qwen2.5-coder:0.5b
MODELO_COMPLEXO=phi3.5
FALLBACK_MODEL=phi3.5

# Classificador: regras | ml | hibrido. ml/hibrido usam o modelo treinado
# (python -m src train-classifier); sem ele, valem as regras.
CLASSIFICADOR=hibrido
CLASSIFICADOR_MODELO=modelos/classificador_tfidf.joblib
# No híbrido, abaixo desta confiança do modelo treinado valem as regras.
CLASSIFICADOR_LIMIAR=0.55

# Contagem de tokens: id do Hugging Face, caminho de um tokenizer.json ou "estimativa".
TOKENIZADOR=microsoft/Phi-3.5-mini-instruct

# Modelo do Ollama usado por experiments/gerar_prompts.py para gerar o conjunto de prompts.
MODELO_GERADOR=gemma4:e4b-it-qat

LOADBALANCER_HOST=127.0.0.1
LOADBALANCER_PORT=8000
LB_URL=http://127.0.0.1:8000

DEV_MODE=true
