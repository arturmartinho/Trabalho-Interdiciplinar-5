# Database
DB_FILE=ai_host.db

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_PORT=11434
OLLAMA_TIMEOUT_SECONDS=120

# Tags como aparecem em `ollama list`.
# MODELO_* é o contrato de src/classificador.py.
MODELO_SIMPLES=ailo-152m-v2
MODELO_CODIGO=qwen2.5-coder:0.5b
MODELO_COMPLEXO=phi3.5
FALLBACK_MODEL=phi3.5

# API do load balancer
LOADBALANCER_HOST=127.0.0.1
LOADBALANCER_PORT=8000

# Logging
LOG_LEVEL=INFO
DEV_MODE=true

# Defaults
DEFAULT_AI_MODEL=
DEFAULT_AI_MODEL_TYPE=local

# Remote AI defaults (optional)
REMOTE_AI_URL=
REMOTE_AI_API_KEY=